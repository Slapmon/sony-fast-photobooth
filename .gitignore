bench_results*.db

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.svelte-kit/

# Fixtures are tracked, but keep the dir from vanishing when empty
!fixtures/shots/.gitkeep
!events/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
