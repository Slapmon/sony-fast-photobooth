# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
dist/
build/

# Env / secrets
.env
config/*.env
config/local.yaml

# Runtime data (per-event content, captured photos, DBs, logs — not source)
/data/
